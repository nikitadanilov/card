class html_checker(html.parser.HTMLParser):
    """Structural checks of the generated HTML.

    This is not a full HTML5 validator. It checks that every element is
    properly closed and nested, that there are no block elements inside
    paragraphs, no nested hyperlinks, no duplicate anchors and that the rows of
    a table have the same number of cells.

    """
    VOID  = { 'area', 'base', 'br', 'col', 'embed', 'hr', 'img', 'input', 'link',
              'meta', 'source', 'track', 'wbr' }
    BLOCK = { 'address', 'article', 'aside', 'blockquote', 'center', 'details',
              'dialog', 'div', 'dl', 'fieldset', 'figcaption', 'figure', 'footer',
              'form', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'header', 'hr', 'main',
              'nav', 'ol', 'p', 'pre', 'section', 'table', 'ul' }
    def __init__(self, name : str):
        super().__init__(convert_charrefs = True)
        self.name    = name
        self.errors  = []
        self.stack   = []
        self.anchors = set()
        self.hrefs   = []  # (line, url, tag)
        self.doctype = False
        self.title   = None
        self.tables  = []  # Stack of tables, each a list of cell counts of rows.
    def error(self, msg : str) -> None:
        self.errors.append('{}:{}: {}'.format(self.name, self.getpos()[0], msg))
    def handle_decl(self, decl):
        if decl.lower() == 'doctype html':
            self.doctype = True
    def handle_starttag(self, tag, attrs):
        a = dict(attrs)
        for (k, v) in attrs:
            if v != None and 'None' in v.split('/'):
                self.error('attribute {}="{}" in <{}>'.format(k, v, tag))
        if tag in self.BLOCK and 'p' in self.stack:
            self.error('block element <{}> inside <p>'.format(tag))
        if tag == 'a' and 'a' in self.stack:
            self.error('nested <a>')
        for k in ('name', 'id'):
            if a.get(k, '') != '' and (tag == 'a' or k == 'id'):
                if a[k] in self.anchors:
                    self.error('duplicate anchor "{}"'.format(a[k]))
                self.anchors.add(a[k])
        for k in ('href', 'src'):
            if k in a and tag in ('a', 'link', 'img'):
                self.hrefs.append((self.getpos()[0], a[k], tag))
        if tag == 'table':
            self.tables.append([])
        elif tag == 'tr' and self.tables:
            self.tables[-1].append(0)
        elif tag in ('td', 'th') and self.tables and self.tables[-1]:
            self.tables[-1][-1] += 1
        if tag not in self.VOID:
            self.stack.append(tag)
    def handle_startendtag(self, tag, attrs):
        self.handle_starttag(tag, attrs)
        if tag not in self.VOID:
            self.stack.pop()
    def handle_endtag(self, tag):
        if tag in self.VOID:
            self.error('end tag for void element <{}>'.format(tag))
        elif not self.stack:
            self.error('stray </{}>'.format(tag))
        elif self.stack[-1] != tag:
            self.error('</{}> closes <{}>'.format(tag, self.stack[-1]))
            if tag in self.stack:
                while self.stack.pop() != tag:
                    pass
        else:
            self.stack.pop()
            if tag == 'table':
                rows = self.tables.pop()
                if len(set(rows)) > 1:
                    self.error('table rows have different numbers of cells: {}'.format(rows))
    def handle_data(self, data):
        if self.stack and self.stack[-1] == 'title':
            self.title = (self.title or '') + data
    def close(self):
        super().close()
        if self.stack:
            self.error('unclosed elements: {}'.format(self.stack))
        if not self.doctype:
            self.error('missing <!DOCTYPE html>')
        if self.title == None:
            self.error('missing <title>')

url_scheme = re.compile(r'^[a-zA-Z][a-zA-Z0-9+.-]*:|^//')

def check_html_dir(d : str, images : bool = True) -> List[str]:
    """Checks all HTML files in directory d and the internal hyperlinks between
    them. Returns the list of errors."""
    files  = {}
    errors = []
    for name in sorted(os.listdir(d)):
        if name.endswith('.html'):
            c = html_checker(name)
            with open(os.path.join(d, name), encoding = 'utf-8') as fd:
                c.feed(fd.read())
            c.close()
            files[name] = c
            errors += c.errors
    for (name, c) in files.items():
        for (line, href, tag) in c.hrefs:
            if url_scheme.match(href) or (tag == 'img' and not images):
                continue
            (path, _, anchor) = href.partition('#')
            target = name if path == '' else urllib.parse.unquote(path)
            where = '{}:{}: '.format(name, line)
            if not os.path.exists(os.path.join(d, target)):
                errors.append(where + 'link to a missing file "{}"'.format(href))
            elif anchor != '' and target in files and \
                 urllib.parse.unquote(anchor) not in files[target].anchors:
                errors.append(where + 'link to a missing anchor "{}"'.format(href))
    return errors

class problems:
    """Collects the problems found by check_deck()."""
    def __init__(self):
        self.list = []
    def add(self, where, kind : str, msg : str) -> None:
        if (where, kind, msg) not in self.list:
            self.list.append((where, kind, msg))
    def error(self, where, msg : str) -> None:
        self.add(where, 'error', msg)
    def warning(self, where, msg : str) -> None:
        self.add(where, 'warning', msg)
    def errors(self) -> int:
        return len([p for p in self.list if p[1] == 'error'])
    def lines(self) -> List[str]:
        return ['{}{}: {}'.format(location(w), k, m) for (w, k, m) in self.list]

