        self.out(('<?xml version="1.0" encoding="utf-8"?>\n'        +
                  '<rss version="2.0">\n'                           +
                  '    <channel>\n'                                 +
                  '        <title>{title}</title>\n'                +
                  '        <link>{url}</link>\n'                    +
                  '        <description>{descr}</description>\n'    +
                  '        <lastBuildDate>{date}</lastBuildDate>\n' +
                  '\n').format(**{ 'title' : html.escape(self.deck.get('deck.title', str, '')),
                                   'url'   : html.escape(self.deck.get('deck.url')),
                                   'descr' : html.escape(self.deck.get('deck.description', str, '')),
                                   'date'  : datetime.datetime.now(datetime.timezone.utc).strftime("%a, %d %b %Y %H:%M:%S %z") }))
        for c in self.deck.cards:
            title = html.escape(c.get('card-title', str, 'card'))
            date = c.series_id.get('timeline', None)
            if date == None:
                continue
            fd = self.fd
            self.fd = io.StringIO()
            for f in c.frags:
                self.frag_render_content(self.deck, c, f)
            content = self.fd.getvalue()
            self.fd = fd
            self.out(('        <item>\n'                                 +
                      '            <title>{title}</title>\n'             +
                      '            <id>{id}</id>\n'                      +
                      '            <link>{url}</link>\n'                 +
                      '            <pubDate>{date}</pubDate>\n'          +
                      '            <content type="html"\n'               +
                      '                     xml:base="{url}">\n'         +
                      '                     {content}</content>\n'       +
                      '        </item>\n'                                +
                      '\n').format(**{ 'title'   : title,
                                       'id'      : c.id(),
                                       'url'     : html.escape(self.deck.get('deck.url') + '/' + c.get(html_file) + '#' + c.get(html_anchor)),
                                       'date'    : date[0:10],
                                       'content' : html.escape(content) }))
        self.out('</channel></rss>')
        self.fd.close()
    def href_wrap(self, target : str, text : str) -> str:
        return self.html_href_pair[0].format(**{ 'ref' : target }) + \
            html.escape(text) + self.html_href_pair[1]
    def card_row(self, c : card, t0 : str, compact : bool) -> List[str]:
        title = self.href_wrap(c.get(html_file) + '#' + c.get(html_anchor),
                               c.get('card-title', str, None))
        if compact:
            return [title]
        brief = html.escape(c.brief(80) + ' ...')
        tags  = ' &nbsp; '.join([self.href_wrap(self.tags_file(t), t)
                                 for t in sorted(c.get('tags', list, []))])
        series = []
        trunks = {}
        for (trunk, z) in c.get(':#', list, []):
            if t0 != trunk:
                trunks[trunk] = '+'
        for trunk in sorted(self.deck.series):
            if t0 != trunk:
                series += ['<tt>' + trunks.get(trunk, ' ') + '</tt>']
        return [title, brief, tags] # + series
    def series_trunk(self, trunk : str, compact : bool, reverse : bool, flat : bool) -> None:
        sequence = list(self.deck.series[trunk])
        sequence.sort(reverse = reverse)
        self.out('<table class="no-borders">')
        self.out('<tr>')
        self.out('<td>')
        self.out(self.href_wrap(self.series_file_full(trunk, compact, not reverse, flat),
                                'reverse'))
        self.out('</td>')
        self.out('<td>')
        self.out(self.href_wrap(self.series_file_full(trunk, not compact, reverse, flat),
                                'expand' if compact else 'compact'))
        self.out('</td>')
        self.out('<td>')
        self.out(self.href_wrap(self.series_file_full(trunk, compact, reverse, not flat),
                                'indexed' if flat else 'flat'))
        self.out('</td>')
        self.out('</tr>')
        self.out('</table>')
        if flat:
            for zahl in sequence:
                card = self.deck.series[trunk][zahl]
                self.card_render_begin_file(self.deck, card)
                self.card_render_frags(self.deck, card)
                self.card_render_end_file(self.deck, card)
                self.out('<p>&nbsp;</p>')
            return
        self.out('<table class="no-borders">')
        if not compact:
            self.out('<thead><tr><th></th><th>Name</th><th>Brief</th><th>Tags</th></tr></thead>')
        for zahl in sequence:
            node = self.deck.series[trunk][zahl]
            self.out('<tr>')
            self.out('<td>')
            self.out(html.escape(zahl))
            self.out('</td>')
            for td in self.card_row(node, trunk, compact):
                self.out('<td>')
                self.out(td)
                self.out('</td>')
            self.out('</tr>')
        self.out('</table>')
    def tag_list(self, tag : str) -> None:
        self.out('<table class="no-borders">')
        self.out('<thead><tr><th>Name</th><th>Brief</th><th>Tags</th></tr></thead>')
        for node in self.deck.tags[tag]:
            self.out('<tr>')
            for td in self.card_row(node, '', False):
                self.out('<td>')
                self.out(td)
                self.out('</td>')
            self.out('</tr>')
        self.out('</table>')
    def href_start_html(self, fr : node, p : place):
        if isinstance(p, url_place):
            ref = p.url
        else:
            assert isinstance(p, span_place) or isinstance(p, node_place)
            ref = self.href(fr, p.node)
        return self.html_href_pair[0].format(**{ 'ref' : ref })
    def href_end_html(self):
        return self.html_href_pair[1]
    def href_start(self, fr : node, p : place):
        self.out(self.href_start_html(fr, p))
    def href_end(self):
        self.out(self.href_end_html())
    def formatif(self, notempty : str, empty : str, s : str):
        return empty if s == '' else notempty.format(s)
    def outnl(self, content : str):
        self.out('\n' + self.indent * 8 * ' ' + content)
