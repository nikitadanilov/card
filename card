# Parsing
# ----------------------------------------------------------------------

def read_config(d : deck, file : str) -> None:
    fd = open(file, 'r')
    for line in fd:
        words = line.strip().split(maxsplit = 2)
        if words[0] == '/':
            d.set(words[1], words[2])
        else:
            assert False
    fd.close()


class CardError(Exception):
    """An error in the input, reported with its source location."""
    def __init__(self, where, msg : str):
        super().__init__(location(where) + msg)
        self.where = where
        self.msg   = msg

def location(where) -> str:
    return '{}:{}: '.format(*where) if where != None else ''

def read_card_file(d : deck, file : str) -> None:
    seq = 0
    fd  = open(file, 'r')
    c   = card.fromfile(d, file, fd, seq)
    c.where = (file, 1)
    f   = None
    current_note = None
    for (lineno, rawline) in enumerate(fd, 1):
        where = (file, lineno)
        line = rawline.strip()
        words = line.split(maxsplit = 2)
        if len(words) > 0 and words[0] in ('///', '//', '/', ':') and len(words) < 3:
            raise CardError(where, 'attribute without a value.')
        if len(line) == 0:
            c.frag_add(f)
            f = None
            current_note = None
        elif words[0] == '///':          # Deck attribute
            d.located(words[1], words[2], where)
            current_note = None
        elif words[0] == '//':           # Card attribute
            c.located(words[1], words[2], where)
            current_note = None
        elif words[0] == '/':            # Fragment attribute / note creation
            if f == None:
                raise CardError(where, 'fragment attribute outside of a fragment.')
            if words[1] == '+*':
                current_note = note(f, words[2], where)
                f.note_add(current_note)
            else:
                f.located(words[1], words[2], where)
                current_note = None
        elif words[0] == ':':            # Note attribute
            if current_note == None:
                raise CardError(where, 'note attribute not following a note.')
            current_note.located(words[1], words[2], where)
        elif words[0] == ';':            # Fragment type
            if len(words) < 2 or words[1] not in frag_types:
                raise CardError(where, 'unknown fragment type, expected one of: {}.'.format(', '.join(frag_types)))
            c.frag_add(f)
            f = frag_types[words[1]](c)
            f.where = where
            current_note = None
        elif words[0] == '\\':         # New card
            c.frag_add(f)
            d.card_add(c)
            seq = seq + 1
            c = card.fromfile(d, file, fd, seq)
            c.where = where
            f = None
            current_note = None
        else:
            current_note = None
            if f == None:
                f = para(c)
                f.where = where
            if rawline[0] == '|':        # Continuation
                rawline = rawline[1:]
            else:
                indent = 0
                while rawline[0] == '>':
                    indent += 1
                    rawline = rawline[1:]
                if indent != 0:
                    f.set('>', indent * '>')
            f.line_add(rawline)
    c.frag_add(f)
    d.card_add(c)
    fd.close()


# ----------------------------------------------------------------------
# Semantic passes
# ----------------------------------------------------------------------

def iter_cards(d : deck):
    return iter(d.cards)


def iter_fragments(d : deck):
    for c in iter_cards(d):
        for f in c.frags:
            yield f


def iter_notes(d : deck):
    for f in iter_fragments(d):
        for n in f.notes:
            yield n


def iter_nodes(d : deck):
    yield d
    for c in iter_cards(d):
        yield c
        for f in c.frags:
            yield f
            for n in f.notes:
                yield n


def iter_card_nodes(d : deck):
    for n in iter_nodes(d):
        if n is not d:
            yield n


def register_series_membership(d : deck, obj : node, spec : str, where) -> None:
    words = spec.split(maxsplit = 1)
    trunk = words[0]
    zahl  = words[1] if len(words) > 1 else obj.id()
    if not isinstance(obj, card):
        raise CardError(where, 'only cards can be placed in series.')
    if zahl in d.series[trunk]:
        raise CardError(where, 'position "{}" in series "{}" is already taken by {}.'.format(
            zahl, trunk, d.series[trunk][zahl].id()))
    if trunk in obj.series_id:
        raise CardError(where, 'the card is already in series "{}".'.format(trunk))
    d.series[trunk][zahl] = obj
    obj.series_id[trunk] = zahl
    obj.add(':#', (trunk, zahl))


def index_node(d : deck, obj : node) -> None:
    if obj.id() in d.ids:          # Identifier must be unique.
        raise CardError(obj.attr_where('id'), 'duplicate identifier "{}", also used at {}.'.format(
            obj.id(), location(d.ids[obj.id()].attr_where('id')).rstrip(': ') or 'another node'))
    d.ids[obj.id()] = obj
    if obj.has('tags') and not isinstance(obj, card):
        raise CardError(obj.attr_where('tags'), 'only cards can be tagged.')
    for t in obj.get('tags', list, []):
        d.tags[t] += [obj]
    for (i, s) in enumerate(obj.get('#', list, [])):
        register_series_membership(d, obj, s, obj.attr_where('#', i))


def index_nodes(d : deck) -> None:
    d.ids = {}
    d.tags = collections.defaultdict(list)
    d.series = collections.defaultdict(dict)
    for obj in iter_nodes(d):
        index_node(d, obj)


def build_node_links(d : deck, n : node, done : set) -> None:
    for x in n.ancestry():
        # Links of a fragment are meant for the fragment, not for its notes.
        if isinstance(n, note) and x is n.parent:
            continue
        for (i, l) in enumerate(x.get('=', list, [])):
            # A link without a "." end does not depend on the node it is
            # inherited by: create it only once.
            if all(not e.strip().startswith('.') for e in l.split('->', 1)):
                if (id(x), i) in done:
                    continue
                done.add((id(x), i))
            link(d, n, l, (x, i))


def build_links(d : deck) -> None:
    done = set()
    for n in iter_nodes(d):
        if n is not d:
            build_node_links(d, n, done)


def attach_styles(n : node) -> None:
    # Only apply styles to paras. This should be done more generically.
    if not isinstance(n, frag) or isinstance(n, para):
        for s in stylenames:
            for x in n.ancestry():
                for (i, regex) in enumerate(x.get(s, list, [])):
                    n.spans.append(stylespan(regex, s, x.attr_where(s, i)))


def attach_series_navigation(d : deck, c : card) -> None:
    for (trunk, zahl) in c.get(':#', list, []):
        sequence = list(d.series[trunk])
        sequence.sort()
        pos = sequence.index(zahl)
        c.cadd(cmd(SERIES, (trunk,
                            d.series[trunk][sequence[pos - 1]] if pos > 0 else None,
                            d.series[trunk][sequence[pos + 1]] if pos + 1 < len(sequence) else None)))


def frag_commands_for(f : frag):
    frag_cmds = {
        para : (PARA_BEGIN, PARA_END),
        math : (MATH_BEGIN, MATH_END),
        code : (CODE_BEGIN, CODE_END),
        head : (HEAD_BEGIN, HEAD_END)
    }
    return frag_cmds.get(type(f), (FRAG_BEGIN, FRAG_END))


def lower_fragment(f : frag) -> List[cmd]:
    out = []
    (begin, end) = frag_commands_for(f)
    out += [cmd(begin, None, f)]
    if f.has('>'):
        indent = len(f.get('>', str, ''))
        out += [cmd(INDENT_BEGIN, indent, f)]

    text = f.content()
    markers = collections.defaultdict(list)
    for s in f.spans:
        (text, markers) = s.applyto(f, text, markers)
    out += f.cut(text, markers)

    if f.has('>'):
        indent = len(f.get('>', str, ''))
        out += [cmd(INDENT_END, indent, f)]
    out += [cmd(end, None, f)]
    return out


def attach_node_decorations(d : deck) -> None:
    # Links are rendered at their spans only. A link to a whole node is
    # rendered at its source span as a hyperlink to the node's anchor.
    attach_styles(d)
    for c in iter_cards(d):
        attach_series_navigation(d, c)
        attach_styles(c)
    for f in iter_fragments(d):
        attach_styles(f)
    for n in iter_notes(d):
        attach_styles(n)


def lower_inline_node(n : note) -> List[cmd]:
    text = n.content()
    markers = collections.defaultdict(list)
    for s in n.spans:
        (text, markers) = s.applyto(n, text, markers)
    return n.cut(text, markers)


def lower_fragments(d : deck) -> None:
    for f in iter_fragments(d):
        f.incmd = lower_fragment(f)
        f.excmd = []
    for n in iter_notes(d):
        n.incmd = lower_inline_node(n)
        n.excmd = []


def wrap_cards(d : deck) -> None:
    for c in iter_cards(d):
        c.pair(cmd(CARD_BEGIN), cmd(CARD_END))


def wrap_deck(d : deck) -> None:
    d.pair(cmd(BEGIN), cmd(END))


def compile_deck(d : deck) -> None:
    # Pass 0: build identifiers index, needed to resolve links and series.
    index_nodes(d)
    # Pass 1: instantiate link and note objects from declarative attributes.
    build_links(d)
    # Pass 2: attach command-level decorations.
    attach_node_decorations(d)
    # Pass 3: lower fragments to command streams.
    lower_fragments(d)
    # Pass 4: wrap structural nodes.
    wrap_cards(d)
    wrap_deck(d)


def render_deck(d : deck) -> None:
    # print('\n'.join([str(x) for x in d.program()]))
    engines[d.get('engine', str, 'html')]().run(d, d.program())

class span:
    """A span is a pattern of contiguous extent of text decorated in some way.

    A span can be "applied" to a given a string, typically a fragment's content:
    find all extents in the string to which the span applies. For each match:

        - apply span transformation function,

        - add markers (which are typically commands) for the matched extent.

    """
    def __init__(self):
        pass
    def find(self, s : str):
        assert False # Define in sub-classes!
    def transform(self, s : str, m):
        assert False # Define in sub-classes!
        
    def apply(self, n : node) -> None:
        out     = n.processed if n.processed is not None else n.content()
        markers = n.markers
        (out, markers) = self.applyto(n, out, markers)
        n.markers = markers
        n.processed = out

    def applyto(self, n : node, out : str, markers):
        pos = 0
        if (n.debug(2)):
            print('apply: markers-in', recstring(markers))
        while True:
            m = self.find(out, pos)
            if m == None:
                break
            if m.start() == m.end(): # Ignore empty matches.
                if m.end() >= len(out):
                    break
                pos = m.end() + 1
                continue
            (out, pos, deltas, inp, exp) = self.transform(out, m)
            if (n.debug(3)):
                print('    out', out, '\n    pos', pos, '\n    deltas', recstring(deltas),
                      '\n    inp', recstring(inp), '\n    exp', recstring(exp));
            for (p, delta) in deltas: # Adjust existing markers to the changed offsets.
                if delta == 0:
                    continue
                for idx in sorted(markers, reverse = delta > 0):
                    if idx > p:
                        markers[idx + delta] += markers[idx]
                        del markers[idx]
                if (n.debug(3)):
                    print('    Adjusted markers to ', p, delta)
                    print('             markers    ', recstring(markers))
            for (idx, cmd) in inp:
                markers[idx] = markers[idx] + [cmd]
            for (idx, cmd) in exp:
                markers[idx] = [cmd] + markers[idx]
        if (n.debug(2)):
            print('apply: markers-ex', recstring(markers))
        return (out, markers)

class respan(span):
    """Span based on a regular expression."""
    def __init__(self, pattern : str, where = None):
        self.re    = pattern
        self.where = where
        try:
            self.regex = re.compile(pattern)
        except re.error as e:
            raise CardError(where, 'invalid regular expression "{}": {}.'.format(pattern, e))
    def find(self, s : str, pos : int):
        return self.regex.search(s, pos)
    def transform(self, s : str, m) -> Tuple[str, int, List[Tuple[int, int]], List[Tuple(int, cmd)], List[Tuple(int, cmd)]]:
        return (s, m.end(), [], [], [])
