def check_url(url : str, timeout : float = 15, anchors : bool = False):
    """Checks that an external resource exists.

    Returns a pair (err, names): err is None, or a pair (kind, message), where
    kind is 'error' if the resource does not exist and 'warning' if the
    failure can be transient; names is, if anchors are requested and the
    resource is an HTML page, the set of the anchors (id and name attributes)
    in it, None otherwise.
    """
    if not re.match(r'^https?://', url):
        return (None, None)
    headers = { 'User-Agent' : 'Mozilla/5.0 (compatible; card-check)' }
    err = None
    for method in (['GET'] if anchors else ['HEAD', 'GET']):
        try:
            req = urllib.request.Request(url, headers = headers, method = method)
            with urllib.request.urlopen(req, timeout = timeout) as r:
                if method == 'GET' and anchors and 'html' in r.headers.get('Content-Type', 'text/html'):
                    text = r.read().decode(r.headers.get_content_charset() or 'latin-1', errors = 'replace')
                    names = set(html.unescape(m.group(2)) for m in
                                re.finditer(r'\b(id|name)\s*=\s*["\']([^"\']*)["\']', text, re.I))
                    return (None, names)
                return (None, None)
        except urllib.error.HTTPError as e:
            transient = e.code == 429 or e.code >= 500
            err = ('warning' if transient else 'error', 'HTTP {} {}'.format(e.code, e.reason))
            if e.code not in (400, 403, 405, 429, 500, 501):
                break # Do not retry with GET.
        except Exception as e:
            err = ('warning', str(getattr(e, 'reason', e)))
            break
    return (err, None)

def fragment_of(url : str) -> Optional[str]:
    """The fragment of the URL that names an anchor, or None (no fragment,
    or a text fragment "#:~:text=...")."""
    frag = url.partition('#')[2]
    if frag == '' or frag.startswith(':~:'):
        return None
    return urllib.parse.unquote(frag)

def tex_macros(c : card) -> List[str]:
    """TeX definitions of a card, without the math delimiters."""
    out = []
    for v in c.join('TeX'):
        v = v.strip()
        for (o, e) in [('\\(', '\\)'), ('\\[', '\\]'), ('$$', '$$')]:
            if v.startswith(o) and v.endswith(e) and len(v) >= len(o) + len(e):
                v = v[len(o) : len(v) - len(e)]
                break
        out.append(v)
    return out

inline_math = re.compile(r'\\\((.*?)\\\)', re.S)

def card_formulae(c : card):
    """(where, display, text) of the formulae of a card, as typeset by MathJax."""
    out = []
    for f in c.frags:
        if isinstance(f, math):
            out.append((f.where, True, f.content()))
        elif isinstance(f, para):
            for m in inline_math.finditer(f.content()):
                out.append((f.where, False, m.group(1)))
        for n in f.notes:
            for m in inline_math.finditer(n.content()):
                out.append((n.where, False, m.group(1)))
    return out

def check_tex_structure(text : str) -> Optional[str]:
    """Checks braces and environments of a formula without TeX."""
    depth = 0
    envs  = []
    for m in re.finditer(r'\\begin\{([^}]*)\}|\\end\{([^}]*)\}|\\.|[{}]', text):
        t = m.group(0)
        if m.group(1) != None:
            envs.append(m.group(1))
        elif m.group(2) != None:
            if not envs or envs.pop() != m.group(2):
                return 'unexpected \\end{{{}}}'.format(m.group(2))
        elif t == '{':
            depth += 1
        elif t == '}':
            depth -= 1
            if depth < 0:
                return 'unbalanced "}"'
    if depth > 0:
        return 'unbalanced "{"'
    if envs:
        return 'unclosed \\begin{{{}}}'.format(envs[-1])
    if len(re.findall(r'\\left\b', text)) != len(re.findall(r'\\right\b', text)):
        return 'unbalanced \\left and \\right'
    return None

def check_tex(c : card, formulae, tex : Optional[str], p : problems) -> None:
    """Checks the formulae of a card by running LaTeX on them."""
    macros = tex_macros(c)
    good = []
    for (where, display, text) in formulae:
        # Structural errors make TeX lose track of the following formulae.
        err = check_tex_structure(text)
        if err != None:
            p.error(where, 'formula "{}": {}.'.format(text.strip(), err))
        else:
            good.append((where, display, text))
    formulae = good
    if tex == None or not formulae:
        return
    lines  = ['\\documentclass{article}',
              '\\usepackage{amsmath,amssymb,amscd}',
              '\\nonstopmode'] + macros + ['\\begin{document}']
    first  = len(lines) + 1
    ranges = []
    for (where, display, text) in formulae:
        start = len(lines) + 1
        body  = text.split('\n')
        lines += ['\\[' if display else '\\('] + body + ['\\]' if display else '\\)', '\\par']
        ranges.append((start, len(lines), where, text))
    lines += ['\\end{document}']
    with tempfile.TemporaryDirectory() as tmp:
        with open(os.path.join(tmp, 'f.tex'), 'w', encoding = 'utf-8') as fd:
            fd.write('\n'.join(lines) + '\n')
        try:
            subprocess.run([tex, '-interaction=nonstopmode', '-no-shell-escape', '-draftmode', 'f.tex'],
                           cwd = tmp, stdin = subprocess.DEVNULL, stdout = subprocess.DEVNULL,
                           stderr = subprocess.DEVNULL, timeout = 120)
        except subprocess.TimeoutExpired:
            p.error(c.where, '{} did not finish on the formulae of the card.'.format(tex))
            return
        try:
            with open(os.path.join(tmp, 'f.log'), encoding = 'utf-8', errors = 'replace') as fd:
                log = fd.read().split('\n')
        except OSError:
            p.error(c.where, '{} produced no log.'.format(tex))
            return
    reported = set()
    for (i, l) in enumerate(log):
        if not l.startswith('! ') or l.startswith('! Emergency stop') or \
           l.startswith('!  ==> Fatal error'):
            continue
        lineno = None
        for k in log[i + 1 : i + 20]:
            m = re.match(r'l\.(\d+)', k)
            if m:
                lineno = int(m.group(1))
                break
        msg = l[2:].rstrip('.')
        if lineno != None and lineno < first:
            key = ('macros', msg)
            if key not in reported:
                p.error(c.attr_where('TeX'), 'TeX definitions: {}.'.format(msg))
        else:
            hit = [r for r in ranges if lineno != None and r[0] <= lineno <= r[1]]
            (start, end, where, text) = hit[0] if hit else (None, None, c.where, '')
            key = (start, msg)
            if key not in reported:
                p.error(where, 'formula "{}": {}.'.format(text.strip(), msg))
        reported.add(key)

def check_deck(files : List[str], offline : bool = False,
               tex : Optional[str] = 'auto') -> problems:
    """Builds the deck in a temporary directory and checks its consistency."""
    p = problems()
    d = deck()
    try:
        for f in files:
            d.cardread(f)
    except CardError as e:
        p.error(e.where, e.msg)
        return p
    outdir = os.path.abspath(d.get('dir', str, 'html_out'))
    with tempfile.TemporaryDirectory() as tmp:
        d.set('dir', tmp)
        try:
            d.crossref()
            d.build()
        except CardError as e:
            p.error(e.where, e.msg)
            return p
        except Exception as e:
            p.error(None, 'card failed: {}: {}'.format(type(e).__name__, e))
            return p
        for e in check_html_dir(tmp, images = False):
            # Missing files are reported below with their source locations.
            if 'link to a missing file' not in e:
                p.error(None, 'generated HTML: ' + e)
        generated = set(os.listdir(tmp))
    # Regular expressions that match nothing.
    matched = collections.defaultdict(lambda: { 'src' : None, 'tgt' : None })
    for l in d.all_links:
        for (end, pl) in [('src', l.src), ('tgt', l.tgt)]:
            if isinstance(pl, span_place):
                m = matched[(id(l.origin[0]), l.origin[1])]
                m[end] = (m[end] or 0) + pl.matches
                m['link'] = l
    for m in matched.values():
        for end in ['src', 'tgt']:
            if m[end] == 0:
                l  = m['link']
                pl = getattr(l, end)
                p.error(l.where(), 'link "{}": regular expression "{}" matches nothing{}.'.format(
                    l.s, pl.pattern, '' if pl.node is l.obj else ' in ' + pl.node.id()))
    for n in iter_notes(d):
        if n.place.matches == 0:
            p.error(n.where, 'note regular expression "{}" matches nothing.'.format(n.place.pattern))
    # List attributes set without '+'.
    for n in iter_nodes(d):
        for key in list_attributes:
            if n.has(key) and isinstance(n.attrs[key], str):
                p.warning(n.attr_where(key), 'list attribute "{0}" is set without "+": '
                          'use "+{0}".'.format(key))
    # Identifiers.
    for n in iter_nodes(d):
        if n.has('id') and re.search(r'\s', n.get('id')):
            p.warning(n.attr_where('id'), 'identifier "{}" contains spaces and cannot be '
                      'used in links.'.format(n.get('id')))
    # Output files.
    files_of = collections.defaultdict(list)
    for c in d.cards:
        files_of[c.get(html_file)].append(c)
    for (name, cards) in files_of.items():
        for c in cards[1:]:
            p.warning(c.where, 'card {} is written to {}, overwriting card {}.'.format(
                c.id(), name, cards[0].id()))
    # Series positions.
    for (trunk, positions) in d.series.items():
        z = list(positions)
        if all(x.isdigit() for x in z) and len(set(len(x) for x in z)) > 1:
            p.warning(positions[z[0]].attr_where('#'), 'positions in series "{}" are numbers of '
                      'different lengths, but they are compared as strings: pad them with '
                      'zeroes.'.format(trunk))
        if trunk == 'timeline':
            for (zahl, c) in positions.items():
                if not re.match(r'^\d{4}-\d{2}-\d{2}', zahl):
                    p.warning(c.attr_where('#'), 'timeline position "{}" does not start with '
                              'a date YYYY-MM-DD.'.format(zahl))
    # Local and external resources.
    urls = collections.defaultdict(list)
    for u in d.urls:
        urls[u.url].append(u.where)
    for f in iter_fragments(d):
        if isinstance(f, img) and f.has('url'):
            urls[f.get('url')].append(f.attr_where('url'))
    external = collections.defaultdict(list) # Page -> URLs on the page.
    for (url, wheres) in urls.items():
        if url_scheme.match(url):
            external[url.partition('#')[0]].append(url)
            continue
        path = urllib.parse.unquote(url.partition('#')[0].partition('?')[0])
        if path != '' and path not in generated and not os.path.exists(os.path.join(outdir, path)):
            for w in sorted(set(wheres), key = lambda w: (w or ('', 0))):
                p.error(w, '"{}" does not exist in the output directory {}.'.format(url, outdir))
    if not offline and external:
        pages = sorted(external)
        def check(page):
            return check_url(page, anchors = any(fragment_of(u) for u in external[page]))
        with concurrent.futures.ThreadPoolExecutor(max_workers = 8) as pool:
            for (page, (err, names)) in zip(pages, pool.map(check, pages)):
                for url in external[page]:
                    msg = err
                    frag = fragment_of(url)
                    if msg == None and names != None and frag != None and frag not in names:
                        msg = ('error', 'no anchor "{}" in the page'.format(frag))
                    if msg != None:
                        for w in sorted(set(urls[url]), key = lambda w: (w or ('', 0))):
                            p.add(w, msg[0], '{}: {}.'.format(url, msg[1]))
    # Mathematics.
    if tex == 'auto':
        tex = shutil.which('pdflatex') or shutil.which('latex')
        if tex == None and any(card_formulae(c) for c in d.cards):
            p.warning(None, 'pdflatex not found: only the structure of formulae is checked.')
    for c in d.cards:
        formulae = card_formulae(c)
        if formulae:
            check_tex(c, formulae, tex, p)
    return p

def main():
    parser = argparse.ArgumentParser(description = 'Render a deck of cards.')
    parser.add_argument('-v', '--verbose', action = 'store_true',
                        help = 'print the internal representation of the deck.')
    parser.add_argument('-c', '--check', action = 'store_true',
                        help = 'check the deck for consistency instead of rendering it.')
    parser.add_argument('--offline', action = 'store_true',
                        help = 'with --check, do not check external URLs.')
    parser.add_argument('files', nargs = '+', metavar = 'FILE', help = 'cardfiles to process.')
    args = parser.parse_args()

    if args.check:
        p = check_deck(args.files, offline = args.offline)
        for l in p.lines():
            print(l)
        print('{} error(s), {} warning(s).'.format(p.errors(), len(p.list) - p.errors()))
        sys.exit(1 if p.errors() > 0 else 0)
    rolodex = deck()
    try:
        for file in args.files:
            rolodex.cardread(file)
        rolodex.crossref()
        rolodex.build()
    except CardError as e:
        print(e, file = sys.stderr)
        sys.exit(1)
    if args.verbose:
        print(rolodex)
        
if __name__ == '__main__':
    main()

