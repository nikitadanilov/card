@typechecked
class span_place(place):
    class link_span(respan):
        def __init__(self, place : span_place, re : str):
            super().__init__(re, place.where())
            self.place = place
        def transform(self, s : str, m) -> Tuple[str, int, List[Tuple[int, int]], List[Tuple(int, cmd)], List[Tuple(int, cmd)]]:
            # Adjust the other end, given the match.
            oldlink = self.place.parent
            if self.place.base == LSRC_BASE:
                other = oldlink.tgt
            else:
                other = oldlink.src
            if isinstance(other, url_place):
                # Create new link with replaced target
                newlink = link(oldlink.obj.deck(), oldlink.obj, ". -> .", oldlink.origin)
                try:
                    url = other.url.format(**m.groupdict())
                except (KeyError, IndexError, ValueError) as e:
                    raise CardError(oldlink.where(), 'cannot substitute the groups of "{}" into URL "{}" '
                                    '(literal braces must be doubled): {}: {}.'.format(
                                        self.re, other.url, type(e).__name__, e))
                copy = url_place(newlink, url)
                # Report problems with the URL at the link attribute if it is set
                # on the fragment or note itself, otherwise at the fragment.
                inherited = oldlink.origin == None or oldlink.origin[0] is not oldlink.obj
                copy.where = oldlink.obj.where if inherited else oldlink.where()
                oldlink.deck.urls.append(copy)
                if self.place.base == LSRC_BASE:
                    newlink.tgt = copy
                else:
                    newlink.src = copy
                oldlink = newlink
            self.place.matches += 1
            return (s, m.end(), [],
                    [(m.start(), cmd(self.place.base + L_START, oldlink))],
                    [(m.end(),   cmd(self.place.base + L_END,   oldlink))])
    def __init__(self, parent, obj : node, pattern : str, base : int):
        self.node   = obj
        self.parent = parent
        self.base   = base
        self.pattern = pattern
        self.matches = 0
        self.span   = span_place.link_span(self, pattern)
        self.node.spans.append(self.span)
    def where(self):
        return self.parent.where() if isinstance(self.parent, link) else self.parent.where
    def __str__(self) -> str:
        return 'span_place: "' + self.pattern + '"'
    def __repr__(self) -> str:
        return self.__str__()

class cmdspan(respan):
    """Span decorating the extent with particular commands."""
    def __init__(self, pattern : str, acts : Dict[str, (Optional[str], Optional[cmd], Optional[cmd])], where = None):
        super().__init__(pattern, where)
        self.acts = acts
        missing = [a for a in acts if a not in self.regex.groupindex]
        if missing:
            raise CardError(where, 'regular expression "{}" has no group(s) named {}.'.format(
                pattern, ', '.join(missing)))
    def transform(self, s : str, m) -> Tuple[str, int, List[Tuple[int, int]], List[Tuple(int, cmd)], List[Tuple(int, cmd)]]:
        # Sort the matched groups
        groups = sorted([(m.span(aname), aname) for aname in self.acts], key = lambda x: x[0][0])
        out  = ''
        last = 0
        inp  = []
        exp  = []
        deltas = []
        for ((start, end), aname) in groups:
            (replacement, incmd, excmd) = self.acts[aname]
            if start > 0:
                out += s[last : start]
            orig = m.group(aname)
            if replacement != None:
                repl = replacement.format(orig)
                out += repl
                deltas += [(len(out), len(repl) - len(orig))]
            else:
                out += orig
            if incmd != None:
                inp += [(len(out), incmd)]
            if excmd != None:
                exp += [(len(out), excmd)]
            last = end
        term = len(out)
        out += s[last:]
        return (out, term, deltas, inp, exp)

class stylespan(cmdspan):
    def __init__(self, pattern : str, style : str, where = None):
        styleop = stylenames[style]
        super().__init__(pattern, { 'open'  : ('', cmd(STYLE_BEGIN, styleop), None),
                                    'close' : ('', None, cmd(STYLE_END, styleop)) }, where)

@typechecked
class link:
    """Hyperlink.

    A link connects two places: the source to the target. A place can be: a node
    (card or fragment), a span within a node (defined via regular expression, or
    line number, or...) or a URL.

    Link attribute ('=') grammar:

        LINK  ::= SRC '->' TGT
        SRC   ::= PLACE
        TGT   ::= PLACE
        PLACE ::= URL | NODE [SPAN]
        URL   ::= ...
        NODE  ::= '.' | '!' IDENTIFIER
        SPAN  ::= '"' REGEX '"'
    """
    def __init__(self, d : deck, obj : node, s : str, origin = None):
        self.deck = d
        self.obj = obj
        self.s = s
        self.quoted = False
        self.origin = origin # (node, index) of the '=' attribute value.
        if origin != None:
            d.all_links.append(self)
        self.parse()
    def where(self):
        return self.origin[0].attr_where('=', self.origin[1]) if self.origin != None else self.obj.where
    def parse(self) -> None:
        parts = self.s.split('->', 1)
        if len(parts) != 2:
            raise CardError(self.where(), 'link "{}" has no "->".'.format(self.s))
        self.src = self.place(parts[0].strip(), LSRC_BASE)
        self.tgt = self.place(parts[1].strip(), LTGT_BASE)
    def place(self, s : str, base : int) -> place:
        if len(s) == 0:
            raise CardError(self.where(), 'link "{}" has an empty end.'.format(self.s))
        rest = s[1:].strip()
        if   s[0] == '.':
            obj = self.obj
        elif s[0] == '!':
            parts = rest.split(' ', 1)
            if parts[0] not in self.deck.ids:
                raise CardError(self.where(), 'link "{}" refers to unknown identifier "{}".'.format(self.s, parts[0]))
            obj   = self.deck.ids[parts[0]]
            rest  = parts[1] if len(parts) > 1 else ''
        else:
            p = url_place(self, s)
            p.where = self.where()
            return p
        rest = rest.strip()
        if rest != '':
            if len(rest) < 2 or rest[0] != '"' or rest[-1] != '"':
                raise CardError(self.where(), 'link "{}": expected a quoted regular expression, got {}.'.format(self.s, rest))
            return span_place(self, obj, rest[1:-1], base)
        else:
            return node_place(self, obj)
    def base(self, n : node) -> int:
        assert n == self.src.node or n == self.tgt.node
        return LSRC_BASE if n == self.src.node else LTGT_BASE
    def __str__(self) -> str:
        return self.src.__str__() + ' -> ' + self.tgt.__str__()
    def __repr__(self) -> str:
        return self.__str__()

